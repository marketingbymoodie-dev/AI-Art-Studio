{% comment %}
  My Pet — storefront pet-swap on a published Petposterous catalogue design.
  Shows only when ai_art_studio.my_pet_enabled is true AND the product carries
  ai_art_studio.design_candidate_id (set by the flywheel catalogue promote step).
  Default placement: below colour swatches, above Add to cart, full width.
{% endcomment %}

{% assign candidate_id = product.metafields.ai_art_studio.design_candidate_id.value %}
{% assign my_pet_enabled = product.metafields.ai_art_studio.my_pet_enabled.value %}

{% if candidate_id != blank and my_pet_enabled != false %}
  {% assign button_label = block.settings.button_label | default: "My Pet" %}
  {% assign button_subtitle = block.settings.button_subtitle | default: "See your pet on this design" %}
  {% assign preview_mode = block.settings.preview_mode | default: "modal" %}

  <div
    class="appai-my-pet"
    id="appai-my-pet-{{ block.id }}"
    data-candidate-id="{{ candidate_id | escape }}"
    data-product-id="{{ product.id }}"
    data-shop-domain="{{ shop.permanent_domain }}"
    data-variants="{{ product.variants | json | escape }}"
    data-option-names="{{ product.options_with_values | map: 'name' | join: '::' | escape }}"
    data-selected-variant="{{ product.selected_or_first_available_variant.id }}"
    data-page-url="{{ shop.url }}{{ product.url }}"
    data-preview-mode="{{ preview_mode | escape }}"
  >
    <button type="button" class="appai-my-pet__button" data-appai-my-pet-open>
      {{ button_label | escape }}
    </button>
    {% comment %}
      Single caption slot that swaps between two messages at different moments:
      — Pre-first-generation (perListingCount === 0): the theme-setting subtitle
        ("See your pet on this design") — sells the button to a new shopper.
      — Post-first-generation: the cap caption ("X of Y free designs remaining")
        — informs a shopper who has already used attempts.
      JS reads data-subtitle to restore the subtitle on cap-status refresh; the
      initial inline text is the pre-JS / no-JS fallback. :empty in the <style>
      block collapses the element entirely when neither message applies (subtitle
      blank + no cap data yet).
    {% endcomment %}
    <p class="appai-my-pet__caption" data-subtitle="{{ button_subtitle | escape }}">{{ button_subtitle | escape }}</p>
  </div>
  <script src="{{ 'appai-my-pet.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "My Pet",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "My Pet",
      "info": "Text shown on the button itself."
    },
    {
      "type": "text",
      "id": "button_subtitle",
      "label": "Button subtitle",
      "default": "See your pet on this design",
      "info": "Small caption shown below the button. Leave blank to hide."
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "Preview mode",
      "default": "modal",
      "options": [
        { "value": "modal", "label": "Modal (default — opens in a popup)" },
        { "value": "inline", "label": "Inline — swap product image (experimental)" }
      ],
      "info": "Inline mode replaces the product page's hero image with the generated preview, hooks into the theme's native colour/size swatches, and uses the theme's Add to cart button. If the hero image can't be found on your theme, the preview falls back to modal automatically."
    }
  ]
}
{% endschema %}

<style>
  :root {
    /*
     * Polish 8 — named fallback token for the My Pet CTA. Only kicks in when
     * NEITHER the live JS sampling of the theme's own Add to cart button
     * (--appai-my-pet-cta, set in appai-my-pet.js's applyThemeVars) NOR the
     * theme's own --color-button-background setting-token exists. This is
     * the current brand red (matches the hero "WEAR YOUR PET PEEVE" button) —
     * edit here, in one place, if the brand colour is retuned later and the
     * other two sources are ever unavailable.
     */
    --appai-my-pet-cta-fallback: #D65857;
  }
  .appai-my-pet {
    width: 100%;
    margin: 0.75rem 0;
  }
  .appai-my-pet__button {
    display: block;
    width: 100%;
    padding: 0.85em 1.5em;
    font-size: 1em;
    font-weight: 600;
    border-radius: var(--appai-my-pet-radius, 4px);
    cursor: pointer;
    border: none;
    /*
     * Polish 8 — filled CTA matching the theme's existing Primary button
     * (same visual family as "WEAR YOUR PET PEEVE") instead of a competing
     * fourth red. Priority order: (1) --appai-my-pet-cta — only set by
     * appai-my-pet.js when the live Add-to-cart button sample is confidently
     * red-family, i.e. direct proof it IS the brand red; (2) the theme's own
     * --color-button-background settings token (what most Dawn-family themes,
     * incl. Ritual, expose for their Primary button — covers the common case
     * where Add to cart isn't red but the theme's Primary button style is);
     * (3) hardcoded named fallback above. Text stays white to match the
     * Primary button's own text treatment, with the theme's token preferred
     * if it exposes one.
     */
    background: var(--appai-my-pet-cta, var(--color-button-background, var(--appai-my-pet-cta-fallback)));
    color: var(--color-button-text, #ffffff);
  }
  .appai-my-pet__button:hover {
    opacity: 0.85;
  }
  .appai-my-pet__caption {
    margin: 0.4em 0 0 !important;
    font-size: 0.9em !important;
    font-weight: 500 !important;
    text-align: center !important;
    /* !important so themes that force all <p> to inherit the section's foreground
       (e.g. white-on-white inside product-info) can't hide the caption. */
    color: var(--appai-my-pet-caption-fg, #666666) !important;
    opacity: 1 !important;
  }
  /* Collapse the caption slot entirely when neither the theme subtitle nor the
     cap caption has anything to say (prevents an empty line of padding when a
     merchant blanks the subtitle AND the shopper hasn't generated yet). */
  .appai-my-pet__caption:empty {
    display: none;
  }
  /*
   * Polish 9 — shimmer sweep on the "X free designs remaining" caption, using
   * the CTA colour as the highlight band so it visually ties back to the
   * button. Toggled on/off in JS (renderAttemptsCaption) — only applied on
   * the inviting "you have tries left" state, never on the cap-reached state.
   * Ported from client/src/index.css's .shimmer-text admin pattern, which
   * doesn't load on the storefront.
   */
  .appai-my-pet__caption.appai-shimmer {
    background: linear-gradient(
      90deg,
      var(--appai-my-pet-caption-fg, #666666) 0%,
      var(--appai-my-pet-cta, var(--color-button-background, var(--appai-my-pet-cta-fallback))) 50%,
      var(--appai-my-pet-caption-fg, #666666) 100%
    ) !important;
    background-size: 200% auto !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    -webkit-text-fill-color: transparent !important;
    color: transparent !important;
    animation: appai-shimmer-sweep 2.2s linear infinite;
  }
  @keyframes appai-shimmer-sweep {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .appai-my-pet__caption.appai-shimmer {
      animation: none;
      -webkit-text-fill-color: unset !important;
      color: var(--appai-my-pet-caption-fg, #666666) !important;
      background: none !important;
    }
  }
</style>
